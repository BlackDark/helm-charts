{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>blackdark/renovate-base//default.json5", ":pinVersions"],
  separateMultipleMajor: true,
  packageRules: [
    {
      description: "Majors: one PR each, merged by hand",
      groupName: null,
      matchUpdateTypes: ["major"],
      addLabels: ["major"],
      automerge: false,
    },
  ],
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/\\.yaml$/"],
      matchStrings: [
        "# ?renovate datasource=(?<datasource>.+?) depName=(?<depName>.+)\\n.+: [\"']?(?<currentValue>.+?)[\"']?\\n",
      ],
    },
    {
      customType: "regex",
      managerFilePatterns: ["/\\.github/workflows/.*\\.ya?ml$/"],
      matchStrings: [
        '# actionlint-local-archive\\s+ACTIONLINT_VERSION: "(?<currentValue>[^"]+)"\\s+ACTIONLINT_SHA256: "(?<currentDigest>[a-f0-9]{64})"',
      ],
      depNameTemplate: "rhysd/actionlint",
      datasourceTemplate: "github-release-attachments",
    },
  ],
}
